# Supabase project settings (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key: needed only for the protected manager setup flow.
# Never use NEXT_PUBLIC_ for this value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
MANAGER_SETUP_SECRET=replace-with-a-long-random-secret

# Optional. If unset, the deterministic English/Hinglish parser always runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
